OPENAI_API_KEY=
# Optional: override the extraction model
# OPENAI_MODEL=gpt-5.4-mini

# Pollar publishable key (pub_testnet_...) from dashboard.pollar.xyz → Build → API Keys → Publishable keys.
# Never put a secret (sec_...) key or a PAT here: VITE_* values are shipped to the browser.
VITE_POLLAR_API_KEY=

# Testnet only, server-side (never VITE_): secret of the account that sponsors claim fees and trustline
# reserves. npm run setup:testnet creates it and writes it to .env.demo; copy the line here.
SPONSOR_SECRET=
